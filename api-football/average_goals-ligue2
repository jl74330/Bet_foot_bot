import requests

# Set up the API endpoint and headers
url = "https://v3.football.api-sports.io/fixtures"
headers = {
    'x-rapidapi-key': '310f3659ee19ce4fa5b2b7c51e463cbf',
    'x-rapidapi-host': 'v3.football.api-sports.io'
}

# Define the parameters for the request
seasons = ['2022']  # List of seasons you want to include
total_goals = 0
total_matches = 0

for season in seasons:
    params = {
        'league': '39',  # Ligue 2 ID
        'season': season,  # Specify the season
        'status': 'FT'  # Only finished matches
    }

    # Make the request
    response = requests.get(url, headers=headers, params=params)

    # Check if the request was successful
    if response.status_code == 200:
        data = response.json()
        fixtures = data['response']

        # Calculate the total goals and matches
        for fixture in fixtures:
            total_goals += fixture['goals']['home'] + fixture['goals']['away']
            total_matches += 1
    else:
        print(f"Failed to retrieve data for season {season}:", response.status_code)

print(response.json())
# Calculate the average goals per game across all seasons
average_goals = total_goals / total_matches if total_matches > 0 else 0
print(f"Average goals per game across seasons {', '.join(seasons)}: {average_goals:.2f}")